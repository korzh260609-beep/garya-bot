NODE_ENV=development
SG_ENVIRONMENT=local
SG_REVISION=dev

# Block 15 — Production AI Integration
# Never commit a real key. Configure it only in the deployment secret store.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=medium
OPENAI_FALLBACK_MODEL=

# Configure current provider pricing so role cost limits are meaningful.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_FALLBACK_INPUT_COST_PER_MILLION=0
OPENAI_FALLBACK_OUTPUT_COST_PER_MILLION=0

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=100

# AI remains disabled unless explicitly enabled.
SG_AI_ENABLED=false
# Emergency switch takes precedence over SG_AI_ENABLED.
SG_AI_EMERGENCY_DISABLED=false
SG_AI_REJECT_SENSITIVE_CONTEXT=true
SG_AI_MAX_INPUT_CHARACTERS=24000
SG_AI_MAX_OUTPUT_TOKENS=2000
SG_AI_GUEST_MAX_COST_USD=0.01
SG_AI_CITIZEN_MAX_COST_USD=0.05
SG_AI_MONARCH_MAX_COST_USD=1

# Block 14 — Telegram Production Integration
# SG 2.0-compatible deployment: keep the existing TELEGRAM_BOT_TOKEN or BOT_TOKEN.
# Render supplies RENDER_EXTERNAL_URL / RENDER_EXTERNAL_HOSTNAME automatically.
TELEGRAM_BOT_TOKEN=
# BOT_TOKEN=  # legacy SG 2.0 alias
# BASE_URL=   # optional outside Render

# Optional overrides only; no new Render ENV is required for the default deployment.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
# TELEGRAM_BOT_USER_ID=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_API_TIMEOUT_MS=10000
# TELEGRAM_API_MAX_RETRIES=2
# TELEGRAM_SANDBOX_ENABLED=false
