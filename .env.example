NODE_ENV=development
SG_ENVIRONMENT=local
SG_REVISION=dev
SG_PROJECT_SCOPE=sg2.1

# Block 17 — Render Deployment
# Render web/worker use PostgreSQL persistence. DATABASE_URL is injected from Render Postgres.
SG_PERSISTENCE_MODE=postgres
DATABASE_URL=
DATABASE_SSL=false

# Canonical SG owner identity.
# MONARCH_GLOBAL_USER_ID is the stable root of Monarch/owner authority.
# The Telegram ID is only the trusted bootstrap/link for the owner's Telegram account.
MONARCH_GLOBAL_USER_ID=
MONARCH_USER_ID=
# Optional SG 2.1 aliases. If present, they override the legacy-compatible names above.
# SG_MONARCH_GLOBAL_USER_ID=
# SG_MONARCH_TELEGRAM_USER_ID=

# Block 16.18 — Monarch Control / Owner Security.
# Lockdown blocks owner-sensitive SG-wide writes/execution even for the verified owner,
# while ordinary read/diagnostic surfaces still obey their existing permissions.
SECURITY_LOCKDOWN=false
# Optional anti-bruteforce tuning for repeated owner-only authorization failures.
# SG_SECURITY_FAILURE_WINDOW_MS=60000
# SG_SECURITY_MAX_FAILURES_PER_WINDOW=10

# Block 19 — Security and Operations.
# All values below are optional and have validated defaults.
# Rate limiting is layered: transport/network at Telegram ingress and identity where a resolved global identity is available.
# SG_RATE_LIMIT_WINDOW_MS=60000
# SG_RATE_LIMIT_IDENTITY_MAX=120
# SG_RATE_LIMIT_TRANSPORT_MAX=600
# SG_RATE_LIMIT_NETWORK_MAX=240
# SG_MAX_HTTP_BODY_BYTES=1048576
# SG_ALERT_ERROR_THRESHOLD=5
# SG_ALERT_SECURITY_DENIAL_THRESHOLD=5
# SG_DATA_RETENTION_DAYS=90
# Emergency controls. Existing SECURITY_LOCKDOWN and Block 16.16 feature kill switches remain authoritative for owner-sensitive/protected operations.
# SG_AUTOMATION_EMERGENCY_DISABLED=false
# SG_TELEGRAM_INGRESS_DISABLED=false

# Optional Block 16.5 default for the monarch; must be an IANA timezone.
SG_MONARCH_TIMEZONE=
# Optional Block 16.6 preferred language for the monarch, e.g. ru, uk, en, pl.
SG_MONARCH_LANGUAGE=
# Block 16.6 bounded fallback when message/preference/platform locale provide no usable language signal.
SG_FALLBACK_LANGUAGE=en
# Render supplies PORT to the web service.
# PORT=10000
# Set false only when registering the Telegram webhook by a separate controlled procedure.
TELEGRAM_REGISTER_WEBHOOK=true

# Block 15 — Production AI Integration
# Never commit a real key. Configure it only in the deployment secret store.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=medium
OPENAI_FALLBACK_MODEL=

# Configure current provider pricing so role cost limits are meaningful.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_FALLBACK_INPUT_COST_PER_MILLION=0
OPENAI_FALLBACK_OUTPUT_COST_PER_MILLION=0

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=100

# AI remains disabled unless explicitly enabled.
SG_AI_ENABLED=false
# Emergency switch takes precedence over SG_AI_ENABLED.
SG_AI_EMERGENCY_DISABLED=false
SG_AI_REJECT_SENSITIVE_CONTEXT=true
SG_AI_MAX_INPUT_CHARACTERS=24000
SG_AI_MAX_OUTPUT_TOKENS=2000
SG_AI_GUEST_MAX_COST_USD=0.01
SG_AI_CITIZEN_MAX_COST_USD=0.05
SG_AI_MONARCH_MAX_COST_USD=1

# Block 16.7 — Configuration & Policy Layer
# Optional deployment inputs. All have validated built-in defaults; no new value is mandatory.
# These inputs can restrict operational limits but do not grant identity, permissions, scope or resource authority.
# SG_POLICY_REQUIRE_CONFIRMATION_FOR_PROTECTED=true
# SG_POLICY_MAX_AUTO_RISK=medium
# SG_POLICY_MAX_AUTO_COST_USD=0.05
# SG_CAPABILITY_MAX_RETRIES=5
# SG_CAPABILITY_MAX_TIMEOUT_MS=300000
# SG_SOURCE_MAX_PER_REQUEST=20
# SG_AUTONOMY_MAX_ACTIONS_PER_RUN=10
# SG_AUTONOMY_MAX_DELEGATION_DEPTH=3
# SG_AUTOMATION_MAX_RETRY_ATTEMPTS=3
# SG_DELIVERY_MAX_ATTEMPTS=3
# SG_DELIVERY_MAX_PAYLOAD_BYTES=1000000

# Block 14 — Telegram Production Integration
# SG 2.0-compatible deployment: keep the existing TELEGRAM_BOT_TOKEN or BOT_TOKEN.
# Render supplies RENDER_EXTERNAL_URL / RENDER_EXTERNAL_HOSTNAME automatically.
TELEGRAM_BOT_TOKEN=
# BOT_TOKEN=  # legacy SG 2.0 alias
# BASE_URL=   # optional outside Render

# Optional overrides only.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
# TELEGRAM_BOT_USER_ID=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_API_TIMEOUT_MS=10000
# TELEGRAM_API_MAX_RETRIES=2
# TELEGRAM_SANDBOX_ENABLED=false

# Worker tuning. Keep defaults unless runtime evidence requires a change.
# SG_WORKER_ID=
# SG_WORKER_LEASE_MS=30000
# SG_WORKER_HEARTBEAT_MS=10000
# SG_WORKER_POLL_MS=1000

# Universal Diagnostics D1-D12 — independent read-only diagnostic service.
# Start separately with: npm run start:diagnostics
# Full /api/* access requires BOTH the diagnostics token and canonical Monarch global_user_id.
# Keep tokens only in the deployment secret store.
# DIAGNOSTICS_ADMIN_TOKEN=
# DIAGNOSTICS_HOST=0.0.0.0
# DIAGNOSTICS_PORT=8790
# DIAGNOSTICS_DB_POOL_MAX=4
# DIAGNOSTICS_DB_CONNECT_TIMEOUT_MS=5000
# RUN_DIAGNOSTICS_MIGRATIONS_ON_BOOT=false
# DIAGNOSTICS_GITHUB_REPOSITORY=korzh260609-beep/garya-bot
# DIAGNOSTICS_GITHUB_BRANCH=dev/sg2.1-semantic
# DIAGNOSTICS_GITHUB_TOKEN=
# DIAGNOSTICS_EXPECTED_REVISION=
# DIAGNOSTICS_SG_HEALTH_URL=
# DIAGNOSTICS_WORKER_HEALTH_URL=
# DIAGNOSTICS_IN_FLIGHT_GRACE_MS=300000
