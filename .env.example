# SG 2.0 environment contract
# Names must remain compatible with main unless Monarch approves a change.

# Telegram
BOT_TOKEN=

# Database
DATABASE_URL=

# Owner / Monarch
MONARCH_USER_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public app URL for Telegram webhook
