# AGENT NOTE:
# This file documents the SG 2.0 environment contract.
# Env names must stay compatible with main and Render unless Monarch explicitly approves a change.
# Do not rename variables, add production secrets, or change runtime assumptions here without final МОЖНО.

# SG 2.0 environment contract
# Names must remain compatible with main unless Monarch approves a change.

# Telegram
# Prefer TELEGRAM_BOT_TOKEN for clarity.
# BOT_TOKEN is kept as a compatibility fallback with the old Render setup.
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=

# Database
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Owner / Monarch
MONARCH_USER_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public app URL for Telegram webhook
# Prefer Render-provided URL/hostname if available.
# Set BASE_URL manually only if Render does not expose a usable public URL.
BASE_URL=

# Render / Node
NODE_ENV=production
PORT=3000

# Render integration / read-only diagnostics
# Disabled by default. Enable only after Render service id and API key are configured.
RENDER_INTEGRATION_ENABLED=false
RENDER_API_KEY=
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_DEFAULT_SERVICE_ID=
RENDER_DEFAULT_OWNER_ID=
RENDER_API_TIMEOUT_MS=15000
RENDER_DEFAULT_DEPLOY_LIMIT=10
RENDER_DEFAULT_LOG_LIMIT=100
RENDER_DEFAULT_LOG_WINDOW_MINUTES=60
