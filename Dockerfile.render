FROM ghcr.io/korzh260609-beep/garya-bot-sg22:88c177a0c44843ce07174d993d6844c9072d07a9

# Render runs the exact prebuilt SG 2.2/OpenClaw image published by GitHub Actions.
# An immutable tag prevents Render's Docker cache from retaining an older :dev image.
# Do not override CMD here: the overlay image already starts
# /app/scripts/sg22-render-entrypoint.sh, which seeds SG/OpenClaw state and
# launches the Gateway with --bind lan and Render's PORT.
