FROM node:24-bookworm

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git openssl procps python3 tini && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

COPY . .

# SG 2.2 source snapshot currently lacks pnpm-lock.yaml. For the Render test
# runtime generate the dependency graph from the exact workspace manifests
# instead of failing before OpenClaw can build.
RUN pnpm install --no-frozen-lockfile \
      --config.supportedArchitectures.os=linux \
      --config.supportedArchitectures.cpu="$(node -p 'process.arch')" \
      --config.supportedArchitectures.libc=glibc

# Match the upstream Docker build sequence. A2UI may fail on constrained/cross
# build hosts; upstream treats that as non-fatal and creates the same stub.
RUN pnpm_config_verify_deps_before_run=false pnpm canvas:a2ui:bundle || \
    (echo "A2UI bundle unavailable: creating upstream-compatible stub" && \
     mkdir -p extensions/canvas/src/host/a2ui && \
     echo "/* A2UI bundle unavailable in this build */" > extensions/canvas/src/host/a2ui/a2ui.bundle.js && \
     echo "stub" > extensions/canvas/src/host/a2ui/.bundle.hash && \
     rm -rf vendor/a2ui apps/shared/OpenClawKit/Tools/CanvasA2UI)

ENV OPENCLAW_PREFER_PNPM=1

RUN NODE_OPTIONS=--max-old-space-size=8192 \
    pnpm_config_verify_deps_before_run=false pnpm build:docker && \
    pnpm_config_verify_deps_before_run=false pnpm ui:build

RUN chmod 755 /app/scripts/sg22-render-entrypoint.sh && \
    chown -R node:node /app

ENV NODE_ENV=production
USER node

ENTRYPOINT ["tini", "-s", "--"]
CMD ["sh", "/app/scripts/sg22-render-entrypoint.sh"]
