FROM ghcr.io/korzh260609-beep/garya-bot-sg22:ddd7a71d078865b1d95a57ec787a8d8113104578

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh nginx \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version \
    && nginx -v
COPY --chown=node:node scripts/sg22-rollback-entrypoint.sh /app/scripts/sg22-rollback-entrypoint.sh
RUN chmod 755 /app/scripts/sg22-rollback-entrypoint.sh
USER node
CMD ["sh", "/app/scripts/sg22-rollback-entrypoint.sh"]

# Last live-verified image: replies in Telegram and resolves the project owner.
# Keep this runtime pinned until the role-aware image passes a real Telegram
# reply test rather than only a container build.
