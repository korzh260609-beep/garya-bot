FROM ghcr.io/korzh260609-beep/garya-bot-sg22:6485bf6b8d2bfe1184252672772485a9c3d201ae

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh nginx \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version \
    && nginx -v
COPY --chown=node:node scripts/sg22-rollback-entrypoint.sh /app/scripts/sg22-rollback-entrypoint.sh
RUN chmod 755 /app/scripts/sg22-rollback-entrypoint.sh
USER node
CMD ["sh", "/app/scripts/sg22-rollback-entrypoint.sh"]

# Role-aware SG 2.2 image built from the exact verified project-role fix.
# Keep the verified Render ingress wrapper, which then starts this image's
# native SG/OpenClaw entrypoint and restores the sg-identity configuration.
