FROM ghcr.io/korzh260609-beep/garya-bot-sg22:73b68b557940b3d1a10d604570fa94b21134272c

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh nginx \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version \
    && nginx -v
COPY --chown=node:node scripts/sg22-rollback-entrypoint.sh /app/scripts/sg22-rollback-entrypoint.sh
RUN chmod 755 /app/scripts/sg22-rollback-entrypoint.sh
USER node
CMD ["sh", "/app/scripts/sg22-rollback-entrypoint.sh"]

# Clean OpenClaw core with the read-only SG Workspace Manager WSP1 plugin.
# Preserve the verified Render ingress wrapper and existing Telegram runtime.
