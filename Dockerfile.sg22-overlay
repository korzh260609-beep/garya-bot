ARG SG22_BASE_IMAGE
FROM ${SG22_BASE_IMAGE}

ARG SG22_IMAGE_COMMIT=unknown
ENV SG22_IMAGE_COMMIT=${SG22_IMAGE_COMMIT}

LABEL org.opencontainers.image.source="https://github.com/korzh260609-beep/garya-bot" \
      org.opencontainers.image.title="SG 2.2 on OpenClaw" \
      org.opencontainers.image.description="SG 2.2 entity overlay above the authoritative OpenClaw runtime"

USER root
WORKDIR /app

# SG 2.2 entity overlay above the compiled OpenClaw runtime.
COPY --chown=node:node sg/workspace /app/sg/workspace
COPY --chown=node:node sg/plugin /app/sg/plugin
COPY --chown=node:node scripts/sg22-render-entrypoint.sh /app/scripts/sg22-render-entrypoint.sh
COPY --chown=node:node scripts/sg22-migrate-global-profiles.mjs /app/scripts/sg22-migrate-global-profiles.mjs
COPY --chown=node:node scripts/sg22-migrate-workspace-memberships.mjs /app/scripts/sg22-migrate-workspace-memberships.mjs
COPY --chown=node:node scripts/sg22-migrate-workspace-requests.mjs /app/scripts/sg22-migrate-workspace-requests.mjs
COPY --chown=node:node scripts/sg22-migrate-wsp5-content.mjs /app/scripts/sg22-migrate-wsp5-content.mjs
RUN chmod 755 /app/scripts/sg22-render-entrypoint.sh /app/scripts/sg22-migrate-global-profiles.mjs /app/scripts/sg22-migrate-workspace-memberships.mjs /app/scripts/sg22-migrate-workspace-requests.mjs /app/scripts/sg22-migrate-wsp5-content.mjs

USER node
ENTRYPOINT ["tini", "-s", "--"]
CMD ["sh", "/app/scripts/sg22-render-entrypoint.sh"]
