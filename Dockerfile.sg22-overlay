ARG SG22_BASE_IMAGE

FROM golang:1.27.1-bookworm AS sg22-go-tools

ARG BLOGWATCHER_VERSION=v0.0.4
ARG SONGSEE_VERSION=v0.1.2
ENV CGO_ENABLED=0
RUN GOBIN=/out go install github.com/Hyaxia/blogwatcher/cmd/blogwatcher@${BLOGWATCHER_VERSION} \
    && GOBIN=/out go install github.com/steipete/songsee/cmd/songsee@${SONGSEE_VERSION}

FROM ${SG22_BASE_IMAGE}

ARG SG22_IMAGE_COMMIT=unknown
ENV SG22_IMAGE_COMMIT=${SG22_IMAGE_COMMIT}
ENV BLOGWATCHER_DB=/data/.openclaw/blogwatcher/blogwatcher.db

LABEL org.opencontainers.image.source="https://github.com/korzh260609-beep/garya-bot" \
      org.opencontainers.image.title="SG 2.2 on OpenClaw" \
      org.opencontainers.image.description="SG 2.2 entity overlay above the authoritative OpenClaw runtime"

USER root
WORKDIR /app

COPY --from=sg22-go-tools /out/blogwatcher /usr/local/bin/blogwatcher
COPY --from=sg22-go-tools /out/songsee /usr/local/bin/songsee

# SG 2.2 entity overlay above the compiled OpenClaw runtime.
COPY --chown=node:node sg/workspace /app/sg/workspace
COPY --chown=node:node sg/plugin /app/sg/plugin
COPY --chown=node:node scripts/sg22-render-entrypoint.sh /app/scripts/sg22-render-entrypoint.sh
COPY --chown=node:node scripts/sg22-project-repo.sh /app/scripts/sg22-project-repo.sh
COPY --chown=node:node scripts/sg22-migrate-project-memory.mjs /app/scripts/sg22-migrate-project-memory.mjs
COPY --chown=node:node scripts/sg22-migrate-global-profiles.mjs /app/scripts/sg22-migrate-global-profiles.mjs
COPY --chown=node:node scripts/sg22-migrate-workspace-memberships.mjs /app/scripts/sg22-migrate-workspace-memberships.mjs
COPY --chown=node:node scripts/sg22-migrate-workspace-requests.mjs /app/scripts/sg22-migrate-workspace-requests.mjs
COPY --chown=node:node scripts/sg22-migrate-wsp5-content.mjs /app/scripts/sg22-migrate-wsp5-content.mjs
COPY --chown=node:node scripts/sg22-migrate-wsp6-assessments.mjs /app/scripts/sg22-migrate-wsp6-assessments.mjs
RUN chmod 755 /app/scripts/sg22-render-entrypoint.sh /app/scripts/sg22-project-repo.sh /app/scripts/sg22-migrate-project-memory.mjs /app/scripts/sg22-migrate-global-profiles.mjs /app/scripts/sg22-migrate-workspace-memberships.mjs /app/scripts/sg22-migrate-workspace-requests.mjs /app/scripts/sg22-migrate-wsp5-content.mjs /app/scripts/sg22-migrate-wsp6-assessments.mjs

USER node
ENTRYPOINT ["tini", "-s", "--"]
CMD ["sh", "/app/scripts/sg22-render-entrypoint.sh"]
