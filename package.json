{
  "name": "garya-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "start": "node ./index.js",
    "smoke:human-mode": "node ./scripts/smokeHumanModeSkeletonImports.js",
    "smoke:living-sg": "node ./scripts/smokeLivingSGSkeletonImports.js",
    "smoke:living-sg-core": "node ./scripts/smokeLivingSGCoreBehavior.js",
    "smoke:system-prompt-living-sg": "node ./scripts/smokeSystemPromptLivingSGCore.js",
    "smoke:system-prompt-source-honesty": "node ./scripts/smokeSystemPromptSourceHonesty.js",
    "smoke:living-sg-meaning-logic": "node ./scripts/smokeLivingSGMeaningLogicContract.js",
    "smoke:living-sg-isolation": "node ./scripts/smokeLivingSGIsolationContract.js",
    "smoke:living-sg-boundary-safety": "node ./scripts/smokeLivingSGBoundarySafetyContract.js",
    "smoke:living-sg-metadata-authority": "node ./scripts/smokeLivingSGMetadataAuthority.js",
    "smoke:legacy-project-intent-metadata-authority": "node ./scripts/smokeLegacyProjectIntentMetadataAuthority.js",
    "smoke:living-sg-repo-source-capability": "node ./scripts/smokeLivingSGRepoSourceCapabilitySkeleton.js",
    "smoke:living-sg-source-proof": "node ./scripts/smokeLivingSGSourceProofBoundary.js",
    "smoke:living-sg-repo-read-planner": "node ./scripts/smokeLivingSGRepoReadRequestPlanner.js",
    "smoke:legacy-project-intent-flow": "node ./scripts/smokeLegacyProjectIntentFlowSkeleton.js",
    "smoke:living-sg-shadow": "node ./scripts/smokeLivingSGShadowContract.js",
    "smoke:ai-temperature": "node ./scripts/smokeAiTemperaturePayload.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:create": "node-pg-migrate create",
    "render:ingest:send": "node ./scripts/renderLogSender.js",
    "render:bridge:run": "node ./scripts/renderLogSourceBridge.js",
    "render:syslog:collector": "node ./syslog/renderSyslogCollector.js"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.61.0",
    "express": "^4.18.2",
    "openai": "^4.28.0",
    "pg": "^8.12.0",
    "node-fetch": "^3.3.2",
    "cheerio": "^1.0.0-rc.12",
    "node-pg-migrate": "^7.9.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "node-pg-migrate": {
    "migrations-dir": "migrations",
    "direction": "up",
    "create-schema": false,
    "schema": "public",
    "ignore-pattern": ".*\\.map$"
  }
}