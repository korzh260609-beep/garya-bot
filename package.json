{
  "name": "sg-2-1-semantic",
  "version": "0.5.0",
  "private": true,
  "description": "SG 2.1 transport-independent semantic core with durable PostgreSQL persistence and workers",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/runtime/entrypoint.js",
    "start:render": "node src/runtime/renderWebEntrypoint.js",
    "start:worker": "node src/automation/workerEntrypoint.js",
    "start:diagnostics": "node src/diagnostics/entrypoint.js",
    "start:legacy-fixture": "node src/index.js",
    "migrate": "node src/persistence/migrate.js",
    "test": "node --test --test-concurrency=1",
    "test:runtime": "node --test tests/runtimeComposition.test.js",
    "test:persistence": "node --test tests/postgresPersistence.test.js",
    "test:workers": "node --test tests/durableWorkers.test.js",
    "test:render": "node --test tests/renderDeployment.test.js",
    "test:diagnostics": "node --test tests/universalDiagnostics.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2eVerification.test.js",
    "test:project-memory": "node --test tests/projectMemory3Contract.test.js",
    "test:security-ops": "node --test --test-concurrency=1 tests/securityOperations.test.js tests/securityOperationsPostgres.test.js tests/telegramWebhookSecurity.test.js",
    "security:scan": "node scripts/securityCheck.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:scan && npm run security:audit && npm run test:security-ops",
    "check:syntax": "find src tests scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run check:syntax && npm test"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}